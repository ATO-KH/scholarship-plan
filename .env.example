# Local private-edition preview. Never put real student records in demo mode.
# Hosted Vercel/Supabase setup: see DEPLOYMENT.md and .env.vercel.example.
# Do not load real production database/storage/roster credentials for local tests.
APP_MODE=demo
PORT=4175
PUBLIC_ORIGIN=http://127.0.0.1:4175
APP_DATA_DIR=./data

# Production: set APP_MODE=production and PUBLIC_ORIGIN to your exact HTTPS origin.
# Chapter-managed login is the production default. Its Chair is a dedicated
# office account, not a member's personal identity.
AUTH_MODE=chapter
CHAIR_ACCOUNT_EMAIL=
CHAIR_AUTH_USER_ID=
SUPABASE_PUBLISHABLE_KEY=
# Legacy Microsoft bootstrap only.
BOOTSTRAP_PROVIDER=microsoft
BOOTSTRAP_SUBJECT=
BOOTSTRAP_NAME=Scholarship Chair
BOOTSTRAP_EMAIL=

# Microsoft Entra: exact university tenant GUID and app registration values.
# Add optional 'acct' claim to ID tokens; this portal accepts only acct=0.
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Optional Google university identity provider.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_HOSTED_DOMAIN=

# Canvas: scoped institutional OAuth developer key, not personal access tokens.
# Enable Allow Include Parameters for the assignments?include[]=submission request.
CANVAS_BASE_URL=
CANVAS_CLIENT_ID=
CANVAS_CLIENT_SECRET=

# Generate 32 random bytes encoded as base64. Required for Canvas token storage.
# Example: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# Keep this stable and backed up securely; changing it makes saved tokens unreadable.
APP_ENCRYPTION_KEY=

# Initial fallback boundaries; later chair Semester settings persist in the database.
# Blank fallback end date means no configured final closure.
SEMESTER_TARGET_DATE=2026-12-04
SEMESTER_END_DATE=
