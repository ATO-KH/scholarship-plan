{
  "name": "ato-scholarship-portal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --env-file-if-exists=.env server/private.mjs",
    "demo": "node --env-file-if-exists=.env server/private.mjs",
    "test": "node --test tests/api.test.mjs private-tests/*.test.mjs",
    "check": "node scripts/check.mjs",
    "db:migrate": "node --env-file-if-exists=.env server/migrate.mjs"
  },
  "engines": {
    "node": "24.x"
  },
  "description": "Private scholarship portal with identity, membership, evidence, and Canvas integration support",
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "jose": "^6.1.0",
    "pg": "^8.23.0"
  },
  "packageManager": "pnpm@11.19.0"
}
