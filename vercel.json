{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "node",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm check",
  "functions": {
    "server.mjs": {
      "maxDuration": 120,
      "includeFiles": "{web,server/migrations}/**",
      "excludeFiles": "{.vercel/**,.git/**,.env*,data/**,uploads/**,tests/**,private-tests/**,coverage/**,**/*.sqlite*,**/*.tar.gz}"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }
      ]
    }
  ]
}
