# Enter these in Vercel Project Settings > Environment Variables > Production ONLY.
# This file contains placeholders, never usable credentials.
APP_MODE=production
ENABLE_EXPERIMENTAL_COREPACK=1
PUBLIC_ORIGIN=

# Supabase Connect > transaction pooler URI (port 6543). The URL may omit
# the password when DATABASE_PASSWORD is provided separately as a secret.
DATABASE_URL=
DATABASE_PASSWORD=
# Optional: Supabase's database CA certificate, if required by your connection.
DATABASE_CA_CERT=

# Supabase API URL and server-only secret key (preferred) or legacy service_role.
# Never a publishable/anon key. Leave the unused alternative blank.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=scholarship-evidence

# Microsoft university identity. Add the optional acct claim to ID tokens.
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
BOOTSTRAP_PROVIDER=microsoft
# Exact verified value: TENANT_GUID:oid:OBJECT_GUID (not an email/name).
BOOTSTRAP_SUBJECT=
BOOTSTRAP_NAME=Scholarship Chair
BOOTSTRAP_EMAIL=

# Optional Canvas; leave all three blank until the university approves a key.
CANVAS_BASE_URL=
CANVAS_CLIENT_ID=
CANVAS_CLIENT_SECRET=
# 32 random bytes in base64; securely preserve it across deployments/restores.
APP_ENCRYPTION_KEY=

# Required chapter eligibility from an explicitly shared private Google Sheet.
# D1: Portal Member ID; E1: Active. At most 1,000 member rows.
# F may hold a confirmed university email for humans; F is not read for access.
# Service account: Viewer on this sheet only; API scope is spreadsheets.readonly.
ROSTER_REQUIRED=true
ROSTER_SHEET_ID=
ROSTER_SHEET_RANGE="'Roster'!D1:E1002"
ROSTER_SERVICE_ACCOUNT_EMAIL=
# PEM private key, actual newlines or literal \n; server-side Production only.
ROSTER_SERVICE_ACCOUNT_PRIVATE_KEY=

# Initial fallback only. Chair Semester settings are persisted after a reset.
SEMESTER_TARGET_DATE=2026-12-04
# Final submission closing date itself, not the date finals end.
SEMESTER_END_DATE=
